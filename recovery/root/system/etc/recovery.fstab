# <source> <mount point> <type> <mount flags> <fs_mgr flags>
/dev/block/bootdevice/by-name/system /system_root ext4 ro,barrier=1 wait
/dev/block/bootdevice/by-name/vendor /vendor ext4 ro,barrier=1 wait
/dev/block/bootdevice/by-name/userdata /data ext4 nosuid,nodev,noatime,discard,noauto_da_alloc,barrier=1 wait,check,formattable
/dev/block/bootdevice/by-name/cache /cache ext4 nosuid,nodev,noatime,barrier=1 wait,check
/dev/block/bootdevice/by-name/misc /misc emmc defaults defaults
