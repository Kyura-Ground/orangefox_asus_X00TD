# <source> <mount point> <type> <mount flags> <fs_mgr flags>
# Physical partitions, matching the LineageOS 23.2 kernel 4.4 tree.
/dev/block/bootdevice/by-name/system /system_root ext4 ro,barrier=1 wait
/dev/block/bootdevice/by-name/vendor /vendor ext4 ro,barrier=1 wait

# Qualcomm ICE uses the legacy FBEv1 keyring.
/dev/block/bootdevice/by-name/userdata /data ext4 nosuid,nodev,barrier=1,noauto_da_alloc,discard,noatime,lazytime wait,check,fileencryption=ice,quota

/dev/block/bootdevice/by-name/cache /cache ext4 noatime,nosuid,nodev,barrier=1 wait,check
/dev/block/bootdevice/by-name/cache /cache f2fs noatime,nosuid,nodev,discard,fsync_mode=nobarrier wait,check
/dev/block/bootdevice/by-name/misc /misc emmc defaults defaults
